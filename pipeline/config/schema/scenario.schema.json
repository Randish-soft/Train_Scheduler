{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ScenarioConfig",
    "type": "object",
    "required": ["scenario_name", "country", "budget_eur", "objectives", "constraints", "data_paths", "artifacts_dir"],
    "properties": {
      "scenario_name": { "type": "string" },
      "country": { "type": "string" },
      "crs": { "type": "string" },
      "budget_eur": { "type": "number", "minimum": 0 },
      "artifacts_dir": { "type": "string" },
      "objectives": {
        "type": "object",
        "properties": {
          "ridership_weight": { "type": "number" },
          "capex_weight": { "type": "number" },
          "travel_time_weight": { "type": "number" }
        },
        "additionalProperties": true
      },
      "constraints": {
        "type": "object",
        "properties": {
          "max_grade_pct": { "type": "number" },
          "min_curve_radius_m": { "type": "number" },
          "protected_areas": { "type": "array", "items": { "type": "string" } },
          "exclude_layers": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      },
      "speed_classes_kph": {
        "type": "array",
        "items": { "type": "number" }
      },
      "service": {
        "type": "object",
        "properties": {
          "headway_min": { "type": "integer", "minimum": 1 },
          "operating_hours": { "type": "string" },
          "dwell_s_default": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "stations": {
        "type": "object",
        "properties": {
          "min_spacing_km": { "type": "number" },
          "candidate_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      },
      "data_paths": {
        "type": "object",
        "properties": {
          "input_dir": { "type": "string" },
          "output_dir": { "type": "string" },
          "edges": { "type": "string" },
          "nodes": { "type": "string" },
          "dem": { "type": "string" },
          "osm_pbf": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
  